# Copy this file to Backend/.env and fill in your values.
# NEVER commit .env or share it - these keys give full access to your project.

# ---- Supabase ----
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the SERVICE ROLE key on the backend (Project Settings -> API).
# The backend writes submissions for users, so the anon key fails when RLS is on.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# (Old name, still supported: SUPABASE_KEY=...)

# ---- Gemini (AI Mentor + embeddings) ----
GEMINI_API_KEY=your-gemini-api-key
# Primary model first, then fallbacks:
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# ---- Submissions queue (Redis + RQ) ----
REDIS_URL=redis://127.0.0.1:6379/0
# auto   = use Redis when reachable, otherwise judge inside the API process
# queue  = always use Redis (needs `python worker.py` running)
# inline = never use Redis (simplest for local development)
SUBMISSION_MODE=auto

# ---- Code execution limits ----
RUN_TIMEOUT_SECONDS=5
COMPILE_TIMEOUT_SECONDS=20
MEMORY_LIMIT_MB=256
MAX_CODE_CHARS=50000
MAX_PARALLEL_TESTS=4
# Run user code as a separate unprivileged OS user. The Docker image already
# sets SANDBOX_USER=sandbox - don't override it there. Not used on Windows.
# SANDBOX_USER=sandbox
# SANDBOX_MAX_PROCESSES=256

# ---- Rate limits (requests per user per minute, 0 = unlimited) ----
RATE_LIMIT_RUN_PER_MIN=20
RATE_LIMIT_SUBMIT_PER_MIN=10
RATE_LIMIT_MENTOR_PER_MIN=8

# ---- HTTP ----
# Comma separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for extra origins, e.g. Vercel preview deployments:
# CORS_ORIGIN_REGEX=https://codementor-.*\.vercel\.app
LOG_LEVEL=INFO
