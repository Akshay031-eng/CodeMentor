# Copy to Frontend/.env (or .env.local) and fill in your values.
# Only PUBLIC keys go here - this file is bundled into the browser app.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# FastAPI backend (uvicorn main:app --port 8002)
VITE_API_URL=http://127.0.0.1:8002

# Optional: one-click demo login button on the sign-in page.
# Create this user in Supabase -> Authentication -> Users -> Add user (auto confirm).
# VITE_DEMO_EMAIL=demo@example.com
# VITE_DEMO_PASSWORD=choose-a-demo-password
